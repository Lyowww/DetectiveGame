# PostgreSQL. Omit this to use the embedded PGlite database in .data/pglite.
DATABASE_URL=postgresql://casefile:casefile@localhost:5432/casefile

# Required in production. Locally, a secret is generated in .data/auth-secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# —— OpenRouter (live dialogue phrasing / intent mapping) ——
# Create a key at https://openrouter.ai/keys — keep it server-side only.
# Never set NEXT_PUBLIC_OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Strict zero-cost inference. Leave true unless you intentionally allow paid routes.
OPENROUTER_FREE_ONLY=true
# Default free router (random eligible free model). Not "best" selection.
OPENROUTER_PRIMARY_MODEL=openrouter/free
# Optional comma-separated explicit free model ids (revalidated against the catalog).
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_CATALOG_TTL_MS=3600000
OPENROUTER_CATALOG_MAX_STALE_MS=21600000
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_APP_DAILY_REQUESTS=400
OPENROUTER_USER_DAILY_REQUESTS=40
# Required to view /admin/openrouter and /api/admin/openrouter
OPENROUTER_ADMIN_TOKEN=
# Observed token budget for this app process (not a provider invoice).
AI_DAILY_TOKEN_BUDGET=40000

# Legacy OpenAI-compatible path only when OPENROUTER_FREE_ONLY=false and no OpenRouter key.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=20000

# Speech is separate. OpenRouter text keys are never used for speech.
# Without SPEECH_API_KEY, typing remains available everywhere.
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_TRANSCRIBE_MODEL=whisper-1
SPEECH_TTS_MODEL=gpt-4o-mini-tts
# Fictional voices only. Format: characterId:providerVoice
SPEECH_VOICES=elena:coral,jonah:ash,owen:ballad,marcus:sage,priya:verse
# Set to off to disable spoken replies even when a speech key exists.
CASEFILE_TTS=

# Public HTTPS origin of this app. Required for the Telegram webhook and menu button.
APP_URL=https://your-host.example

# Telegram bot. The token stays on the server. Create the bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_APP_SHORT_NAME=

# Local mock only. Ignored when NODE_ENV is production.
CASEFILE_TELEGRAM_DEV=
